# What deploy/.env holds. deploy.sh creates deploy/.env with random values on the first run.
# To create it by hand instead: copy this file to deploy/.env and fill in every value.
# .env is gitignored; never commit it.
# Letters and digits only: the passwords go into a mysql:// URL. `openssl rand -hex 24` is safe.

# MySQL root password. MySQL reads it on its first start only.
MYSQL_ROOT_PASSWORD=
# Password of the app's MySQL user `abs_admin`. Also read on MySQL's first start only.
MYSQL_PASSWORD=
# Signs login tokens. Changing it logs everyone out.
JWT_SECRET=

# Optional. Host port for MySQL (default 3306). Set it when 3306 is taken by another MySQL.
# MYSQL_HOST_PORT=3307
